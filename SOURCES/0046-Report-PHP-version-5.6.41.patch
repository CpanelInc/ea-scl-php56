Bump the reported PHP version to 5.6.41 to mark the security backports;
no upstream 5.6.41 release exists.

--- a/configure.in
+++ b/configure.in
@@ -119,7 +119,7 @@
 
 PHP_MAJOR_VERSION=5
 PHP_MINOR_VERSION=6
-PHP_RELEASE_VERSION=40
+PHP_RELEASE_VERSION=41
 PHP_EXTRA_VERSION=""
 PHP_VERSION="$PHP_MAJOR_VERSION.$PHP_MINOR_VERSION.$PHP_RELEASE_VERSION$PHP_EXTRA_VERSION"
 PHP_VERSION_ID=`expr [$]PHP_MAJOR_VERSION \* 10000 + [$]PHP_MINOR_VERSION \* 100 + [$]PHP_RELEASE_VERSION`
--- a/main/php_version.h
+++ b/main/php_version.h
@@ -2,7 +2,7 @@
 /* edit configure.in to change version number */
 #define PHP_MAJOR_VERSION 5
 #define PHP_MINOR_VERSION 6
-#define PHP_RELEASE_VERSION 40
+#define PHP_RELEASE_VERSION 41
 #define PHP_EXTRA_VERSION ""
-#define PHP_VERSION "5.6.40"
-#define PHP_VERSION_ID 50640
+#define PHP_VERSION "5.6.41"
+#define PHP_VERSION_ID 50641
